# Neon Postgres connection string (from console.neon.tech)
DATABASE_URL="postgres://user:password@host.neon.tech/neondb"

# Secret used to sign session JWTs — generate with `openssl rand -base64 32`
AUTH_SECRET="change-me"

# Used only by `npm run db:seed-admin` to bootstrap the first admin account.
# This is a one-time, server-side script — not an API route.
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Existing Klump (Buy Now, Pay Later) integration — both are required for
# the "Klump BNPL" checkout option to work. Get them from the Klump
# merchant dashboard (business.useklump.com).
# Client-side widget key — must be prefixed NEXT_PUBLIC_ to reach the browser.
NEXT_PUBLIC_KLUMP_PUBLIC_KEY=
# Server-side key, used only by /api/klump/verify to confirm a payment.
KLUMP_SECRET_KEY=
